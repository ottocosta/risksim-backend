{% comment %}
  RiskSim — Supply Chain Intelligence Platform
  Shopify Storefront Section

  Installation:
  1. Copy this file into your Shopify theme under: sections/risksim-embed.liquid
  2. In your theme's JSON template (e.g. templates/index.json), add the section:
       "risksim": { "type": "risksim-embed", "settings": {} }
  3. In the Shopify Theme Editor you can enable/disable and adjust height.
{% endcomment %}

<style>
  .risksim-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    background-image: url('https://cdn.shopify.com/s/files/1/1056/0202/3762/files/ChatGPT_Image_Mar_5_2026_01_10_03_PM_800x800.png?v=1772709037');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', sans-serif;
  }
  
  .risksim-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1;
  }
  
  .risksim-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .risksim-hero__title {
    color: #ffffff;
    font-size: clamp(32px, 5vw, 72px);
    font-weight: 800;
    line-height: 1.1;
    margin: 0;
    opacity: 0;
    transform: translateY(40px);
    animation: heroReveal 0.8s ease-out 0.3s forwards;
  }
  
  .risksim-hero__scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: #ffffff;
    opacity: 0.7;
    animation: bounce 2s infinite ease-in-out;
  }
  
  .risksim-hero__scroll-indicator svg {
    width: 32px;
    height: 32px;
  }
  
  @keyframes heroReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0) translateX(-50%); }
    40% { transform: translateY(-15px) translateX(-50%); }
    60% { transform: translateY(-7px) translateX(-50%); }
  }

  .risksim-section {
    width: 100%;
    background: #000;
    padding: 0;
    margin: 0;
  }

  .risksim-section__embed {
    width: 100%;
    border: none;
    display: block;
    background: #000;
  }
</style>

<div class="risksim-hero">
  <div class="risksim-hero__content">
    <h1 class="risksim-hero__title">AI-powered simulation for smarter global supplier strategy.</h1>
  </div>
  <div class="risksim-hero__scroll-indicator">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</div>

<section class="risksim-section">
  <iframe
    class="risksim-section__embed"
    src="{{ section.settings.embed_url | default: 'https://risksim-backend.onrender.com' }}"
    height="{{ section.settings.height | default: 720 }}"
    loading="lazy"
    title="RiskSim Supply Chain Intelligence Platform"
    allow="clipboard-write"
  ></iframe>
</section>

{% schema %}
{
  "name": "RiskSim Embed",
  "tag": "section",
  "class": "risksim-embed-section",
  "settings": [
    {
      "type": "url",
      "id": "embed_url",
      "label": "RiskSim App URL",
      "info": "The URL of your deployed RiskSim instance (e.g. https://risksim-backend.onrender.com)"
    },
    {
      "type": "range",
      "id": "height",
      "min": 400,
      "max": 1200,
      "step": 40,
      "unit": "px",
      "label": "Embed Height",
      "default": 720
    }
  ],
  "presets": [
    {
      "name": "RiskSim Intelligence Panel",
      "category": "Custom"
    }
  ]
}
{% endschema %}
