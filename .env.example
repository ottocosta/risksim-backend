# RiskSim backend — environment variables
# Copy this file to .env for local dev. Never commit .env.

# Claude AI
CLAUDE_API_KEY=sk-ant-...

# Shopify
SHOPIFY_STOREFRONT_TOKEN=...
SHOPIFY_CLIENT_ID=...
SHOPIFY_CLIENT_SECRET=...

# Discord webhooks (cancel requests + demo requests share the same webhook)
DISCORD_CANCEL_WEBHOOK_URL=https://discord.com/api/webhooks/...

# n8n data pipeline auth
# Protects /api/data/* push endpoints and /api/email/subscribers, /api/email/critical-check,
# /api/email/digest-data, /api/email/process-critical-now
DATA_API_KEY=choose-a-long-random-secret

# Upstash Redis — subscriber persistence across deploys
# Create a free database at https://console.upstash.com → Redis → REST API tab
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend — email delivery
# Get an API key at https://resend.com/api-keys
# TODO: verify alerts@risksim.ai domain in Resend, then update EMAIL_FROM in server.js
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to "true" in production to enable the 10-minute critical alert poller
# Leave unset or "false" in local dev to avoid spurious sends
ALERT_POLLER_ENABLED=false
