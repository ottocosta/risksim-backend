<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>{{ page_title }} — RiskSim</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">

    {{ content_for_header }}

    <style>
      /* ═══════════════════════════════════════════════
         RISKSIM — TOTAL REWRITE
         Zero ghosts. Zero duplicates. One nav.
         ID: rs-tactical-nav
         ═══════════════════════════════════════════════ */

      /* ─── Reset ─── */
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      /* ─── Body ─── */
      html, body {
        margin: 0;
        padding: 0;
        background: #000;
        color: #ffffff;
        font-family: 'JetBrains Mono', monospace;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* ─── Scrollbar ─── */
      ::-webkit-scrollbar { width: 5px; }
      ::-webkit-scrollbar-track { background: #000; }
      ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 5px; }
      ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
      html { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.1) #000; }

      /* ═══════════════════════════════════════════════
         NUCLEAR CSS — Ghost Exorcism
         Kill every Shopify-injected header, footer,
         nav, and announcement element.
         EXCEPTION: #rs-tactical-nav is protected.
         ═══════════════════════════════════════════════ */

      /* --- Tag-level kills --- */
      header:not(#rs-tactical-nav),
      footer,
      .announcement-bar {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        max-height: 0 !important;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        opacity: 0 !important;
        pointer-events: none !important;
        position: absolute !important;
        clip: rect(0,0,0,0) !important;
      }

      /* --- Wildcard ID kills (with nav exception) --- */
      [id*="header"]:not(#rs-tactical-nav),
      [id*="footer"]:not(#rs-tactical-nav),
      [id*="announcement"]:not(#rs-tactical-nav),
      [id*="nav"]:not(#rs-tactical-nav) {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        max-height: 0 !important;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        opacity: 0 !important;
        pointer-events: none !important;
        position: absolute !important;
        clip: rect(0,0,0,0) !important;
      }

      /* --- Wildcard class kills (with nav exception) --- */
      [class*="header"]:not(#rs-tactical-nav),
      [class*="footer"]:not(#rs-tactical-nav),
      [class*="announcement"]:not(#rs-tactical-nav),
      [class*="nav"]:not(#rs-tactical-nav) {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        max-height: 0 !important;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        opacity: 0 !important;
        pointer-events: none !important;
        position: absolute !important;
        clip: rect(0,0,0,0) !important;
      }

      /* --- Named Shopify section kills --- */
      #shopify-section-header,
      #header-group,
      #shopify-section-footer,
      #shopify-section-announcement-bar,
      .shopify-section-group-header-group,
      .shopify-section-group-footer-group,
      .shopify-section-group-header-group *,
      .shopify-section-group-footer-group * {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        max-height: 0 !important;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        opacity: 0 !important;
        pointer-events: none !important;
        position: absolute !important;
        clip: rect(0,0,0,0) !important;
      }

      /* ═══════════════════════════════════════════════
         THE ONE TRUE NAV — #rs-tactical-nav
         Centered pill. No ghosts can override this.
         ═══════════════════════════════════════════════ */

      #rs-tactical-nav {
        position: fixed !important;
        top: 30px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999999;
        display: flex !important;
        visibility: visible !important;
        align-items: center;
        gap: 0;
        background: rgba(10, 10, 10, 0.65);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 50px;
        padding: 4px 6px;
        opacity: 0;
        transition: opacity 1.5s cubic-bezier(0.16, 1, 0.3, 1);
        height: auto !important;
        max-height: none !important;
        overflow: visible !important;
        pointer-events: all !important;
        clip: auto !important;
      }

      /* ─── Nav Link ─── */
      #rs-tactical-nav a {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        padding: 10px 22px;
        color: #ffffff;
        opacity: 0.35;
        border-radius: 44px;
        border-bottom: 2px solid transparent;
        transition: opacity 0.3s ease, background 0.3s ease, border-color 0.3s ease;
        position: relative;
      }

      /* Hover */
      #rs-tactical-nav a:hover {
        opacity: 0.8;
        background: rgba(255, 255, 255, 0.04);
      }

      /* Active */
      #rs-tactical-nav a.active {
        opacity: 1;
        color: #ffffff;
        background: rgba(255, 255, 255, 0.07);
        border-bottom-color: #ffffff;
      }

      /* Meta label (SYS_01, etc.) */
      #rs-tactical-nav .tn-meta {
        font-size: 6px;
        font-weight: 300;
        color: rgba(255, 255, 255, 0.25);
        letter-spacing: 0.15em;
        text-transform: uppercase;
        margin-bottom: 3px;
        line-height: 1;
      }

      /* Main label (MAP, AUDIT, WAR-ROOM) */
      #rs-tactical-nav .tn-label {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        line-height: 1;
      }

      /* ─── Main Content Area ─── */
      .rs-content {
        position: relative;
        z-index: 1;
        min-height: 100vh;
      }
    </style>
  </head>

  <body>

    <!-- ═══ THE ONE TRUE NAV ═══ -->
    <nav id="rs-tactical-nav" role="navigation" aria-label="RiskSim Navigation">
      <a href="{{ routes.root_url }}" {% if request.path == '/' %}class="active"{% endif %}>
        <span class="tn-meta">SYS_01</span>
        <span class="tn-label">MAP</span>
      </a>
      <a href="/pages/supplier-audit" {% if request.path contains 'supplier-audit' %}class="active"{% endif %}>
        <span class="tn-meta">SYS_02</span>
        <span class="tn-label">AUDIT</span>
      </a>
      <a href="/pages/enterprise" {% if request.path contains 'enterprise' %}class="active"{% endif %}>
        <span class="tn-meta">SYS_03</span>
        <span class="tn-label">WAR-ROOM</span>
      </a>
    </nav>

    <!-- ═══ Shopify Page Content ═══ -->
    <main class="rs-content" role="main">
      {{ content_for_layout }}
    </main>

    <!-- ═══ Fade-In — exactly 3500ms ═══ -->
    <script>
      (function() {
        var nav = document.getElementById('rs-tactical-nav');
        if (!nav) return;
        setTimeout(function() {
          nav.style.opacity = '1';
        }, 3500);
      })();
    </script>

    <!-- ═══ Checkout postMessage handler ═══ -->
    <script>
      window.addEventListener('message', function(e) {
        if (e.data && e.data.type === 'CHECKOUT') {
          if (e.data.variantId && e.data.sellingPlan) {
            window.location.href = '/cart/' + e.data.variantId + ':1?selling_plan=' + e.data.sellingPlan + '&checkout=true';
          } else if (e.data.url) {
            window.location.href = e.data.url;
          }
        }
      });
    </script>

  </body>
</html>